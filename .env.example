# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev without Docker):
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL — use this when running with docker-compose:
# DATABASE_URL=postgres://postgres:postgres@db:5432/drf_template

# ── Docker Postgres credentials (must match docker-compose.yml) ──────────────
POSTGRES_DB=drf_template
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Redis (optional — needed for Celery or Redis cache) ──────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_DAYS=1
JWT_REFRESH_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# ── File Storage (S3 — optional) ─────────────────────────────────────────────
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1

# ── Error Tracking (Sentry — optional) ───────────────────────────────────────
# SENTRY_DSN=
